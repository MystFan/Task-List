## Ignore Visual Studio temporary files, build results, and
## user-specific files generated by popular Visual Studio add-ons.

# Build Folders
bin/
obj/
out/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# Rider
.idea/

# Resharper
*_ReSharper*/
*.DotSettings.user

# NuGet
*.nupkg
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# dotnet core
*.db
*.db-shm
*.db-wal

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# User secrets
secrets.json
secrets.*

# Publish output
publish/
*.Publish.xml

# IIS Express
/.vs/*/applicationhost.config

# Node modules (if web project uses node)
node_modules/

# JetBrains Rider caches
.idea/
